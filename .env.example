# ─── Server ───────────────────────────────────────────────────────────────────

# Port the Express server listens on
PORT=3001

# The origin of the frontend — used for CORS
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

# Optional: override the SQLite database file path
# DB_PATH=./slave.db

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# (Used in Phase 2 — leave blank for Phase 1)

# OpenAI API key — kept on server only, never sent to the client
OPENAI_API_KEY=

# Model to use for classification and response generation
# OPENAI_MODEL=gpt-4o-mini
