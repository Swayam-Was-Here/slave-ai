# ─── Server ───────────────────────────────────────────────────────────────────

# Port the Express server listens on
PORT=3001

# The origin of the frontend — used for CORS
CLIENT_ORIGIN=http://localhost:5173

# Node environment: development | production
NODE_ENV=development

# Optional: override the SQLite database file path
# DB_PATH=./slave.db

# ─── AI / LLM ─────────────────────────────────────────────────────────────────

# Google Gemini API key — server-side only, NEVER sent to the client
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Gemini model to use for classification and response generation
GEMINI_MODEL=gemini-2.5-pro

# ─── Fallback mode ────────────────────────────────────────────────────────────
# Set to "true" to use deterministic keyword-based classification instead of Gemini.
# Useful for development/demo when no API key is available.
# Fallback results are clearly labelled analysis_source="fallback".
AI_FALLBACK=false
